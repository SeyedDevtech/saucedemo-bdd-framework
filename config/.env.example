# Copy this file to config/.env and adjust. Never commit config/.env.
# No real credentials belong in this file.

# --- Application ---
BASE_URL=https://www.saucedemo.com

# --- Browser ---
# chromium | firefox | webkit
BROWSER=chromium
# true = no visible window (default for CI), false = watch the test run
HEADLESS=true
# Slow every action by N ms (0 = off). Handy while recording the walkthrough video.
SLOW_MO=0

# --- Timeouts (milliseconds) ---
DEFAULT_TIMEOUT_MS=10000
NAVIGATION_TIMEOUT_MS=30000

# --- Logging ---
# debug | info | warn | error
LOG_LEVEL=info

# --- Database (only needed for DB-backed scenarios; SauceDemo has no DB) ---
DB_ENABLED=false
DB_HOST=localhost
DB_PORT=5432
DB_NAME=shop_test
DB_USER=test_user
DB_PASSWORD=change_me
DB_POOL_MAX=5
DB_CONNECT_TIMEOUT_MS=5000
